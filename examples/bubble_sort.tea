import examples/stdlib.tea

#sort pair of values
func sort_pair x y as
  exit x y when x y <
  return y x

# Runs a single bubbling pass over elements
func bubble_pass x y as
  exit  x y sort_pair
        when depth 2 =
  set x y as x y sort_pair
  return  x
          bubble_pass
          y

# Outer loop: runs n passes to sort the stack
func bubble_sort_loop n as
exit when n 1 <=
return  bubble_pass         # this leaves the smallest element on the stack
        n 1 - bubble_sort_loop  # do again, this time over the larger elements only

# Main entry point to sort the stack based on its current size
func bubble_sort as
  return depth bubble_sort_loop


output 1 9 2 8 3 7 4 6 5 bubble_sort          #1 2 3 4 5 6 7 8 9
output 1 9 2 8 3 7 4 6 5 reverse bubble_sort  #1 2 3 4 5 6 7 8 9


