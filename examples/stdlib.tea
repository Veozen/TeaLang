# stack operation
func drop x as
  # discard value
  return

func dup x as
  # duplicate value
  return x x

func 2dup x y as
  # duplicate top pair
  return x y x y

func over x y  as
  # duplicate value
  return x y x

func swap x y as
  # swap two values
  return y x

func rot x y z as
  return y z x

func nip x y as
  #Discard the second element from the top
  return y

func tuck x y as
  # Copy the top element below the second element
  return y x y

func count as
  # count the number of items on the stack at that point
  return depth

func store_n n as
  #store n values from the main stack to the auxiliary stack
  exit when n 0 =
  return store n 1 - store_n

func load_n n as
  #load n values from the auxiliary stack to the main stack
  exit when n 0 =
  return load n 1 - load_n

func store_all as
  # store all values from the main stack to the auxiliary stack
  return depth store_n

func load_all as
  # load all values from the auxiliary stack to the main stack
  return depth load_all

#func reverse_n n as
#    exit when n 0 =
#    set new_count as n 1 -
#
#    return new_count reverse_n new_count extract

func reverse_n n as
  # reverse the order of the previous n values
  return n store_n n load_n

func reverse as
  # reverse the order of all previous values
  return depth reverse_n

func dup_prev_n_loop n look_back as
  exit when n 0 =
  return n look_back + 1 - peek    n 1 - look_back 1 +  dup_prev_n_loop

func dup_prev_n n as
  # duplicate the previous n values
  exit when n 0 =
  return n 0 dup_prev_n_loop

func dup_prev as
  # duplicate all previous values
  return depth dup_prev_n



# math
func min x y as
  # minimum of two values
  exit x when x y <=
  return y

func max x y as
  # maximum of two values
  exit x when x y >=
  return y

#func mod x y as
#    return x x y / y * -


# logical
func not x as
  exit 0 when x 1 =
  return 1

func and x y as
  exit 1 when x y * 0 >
  return 0

func or x y as
    return x not y not and not

func xor x y as
    exit 0 when x y and
    return x y or


# functional
func map x func_id as
  exit x func_id apply when depth 2 =
  return func_id map x func_id apply

func reduce x y func_id as
  exit x y func_id apply when depth 3 =
  set acc as x y func_id apply
  return acc func_id reduce


func filter_one x func_id as
  exit x when x func_id apply 0 >
  return

func filter x func_id as
  exit x func_id filter_one when depth 2 =
  return func_id filter x func_id filter_one

func all x y func_id as
  exit x func_id apply y and  when depth 3 =
  set acc as x func_id apply y and
  return acc func_id all

func any x y func_id as
  exit x func_id apply y or  when depth 3 =
  set acc as x func_id apply y or
  return acc func_id any

func if cond then else as
  exit then when cond
  return else
